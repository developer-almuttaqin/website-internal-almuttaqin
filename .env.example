# Kosongkan dua variabel Supabase di bawah untuk menjalankan MODE DEMO (data contoh lokal di .data/).
# Isi dengan proyek Supabase INTERNAL (terpisah dari proyek web publik) untuk memakai database asli.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role proyek INTERNAL. Hanya dipakai di server: membuat akun pengurus, menarik formulir dari
# web publik, dan /api/intake. Jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Kode sekali pakai (minimal 12 karakter acak) untuk membuat akun direktur pertama di /setup.
# Hanya berlaku selama tabel profiles masih kosong.
SETUP_CODE=

# ---------------------------------------------------------------------------------------------
# Database KEDUA: proyek Supabase milik WEB PUBLIK (almuttaqinculturalcenter.org).
# Web internal membaca dan mengisi konten yang tampil ke jamaah (jadwal Jumat, pengumuman, agenda,
# rekening donasi, laporan transparansi) dan menarik formulir jamaah dari sana. Data internal
# (kas, jamaah, muallaf, dst.) TIDAK pernah disimpan di proyek itu.
# Ambil dari proyek web publik: Project Settings > API. Hanya di server; jangan diberi NEXT_PUBLIC_.
# Bila dikosongkan, menu Web Publik menampilkan petunjuk penyambungan dan sisanya tetap berjalan.
PUBLIC_WEB_SUPABASE_URL=
PUBLIC_WEB_SUPABASE_SERVICE_ROLE_KEY=
# Alamat web publik (untuk tautan "Lihat di web publik").
PUBLIC_WEB_URL=https://almuttaqinculturalcenter.org
# Sama dengan REVALIDATE_SECRET di web publik: perubahan langsung tampil ke jamaah. Tanpa ini perubahan
# tetap tersimpan, tetapi baru tampil setelah cache web publik kedaluwarsa (paling lama satu jam).
PUBLIC_WEB_REVALIDATE_SECRET=

# Token rahasia bersama untuk /api/intake/donations dan /api/intake/room-bookings (opsional; jalur
# cadangan bila sistem lain ingin mengirim data langsung). Minimal 24 karakter acak.
INTAKE_TOKEN=
